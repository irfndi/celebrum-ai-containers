{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": [
      "node"
    ],
    "paths": {
      "@celebrum-ai/shared": [
        "../shared/src"
      ],
      "@celebrum-ai/db": [
        "../db/src"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../shared/src/config/feature-flag-manager.ts",
    "../shared/src/middleware/rbac.ts",
    "../shared/src/middleware/router.ts",
    "../shared/src/infrastructure/cron.ts",
    "../shared/src/routes/api-access-manager.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ],
}