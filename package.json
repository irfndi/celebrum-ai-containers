{
  "name": "celebrum-ai",
  "description": "Celebrum AI Trading Platform - Complete Application",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "tsx scripts/deploy-alchemy.ts production",
    "deploy:alchemy": "tsx scripts/deploy-alchemy.ts production",
    "deploy:alchemy:staging": "tsx scripts/deploy-alchemy.ts staging",
    "deploy:alchemy:dev": "tsx scripts/deploy-alchemy.ts development",
    "deploy:alchemy:dry-run": "tsx scripts/deploy-alchemy.ts production --dry-run",
    "deploy:fallback": "./scripts/deploy/deploy-with-fallback.sh",
    "dev": "wrangler dev",
    "dev:worker": "wrangler dev",
    "dev:web": "astro dev --root src/web",
    "dev:telegram-bot": "wrangler dev --compatibility-date=2024-01-01 --local",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "format": "echo 'Using oxlint for formatting'",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "build": "pnpm run build:web && tsc",
    "test:alchemy": "tsx scripts/test-alchemy-integration.ts",
    "build:db": "tsc && cp -r dist/src/db/* dist/db/ 2>/dev/null || true",
    "build:shared": "tsc && cp -r dist/src/shared/* dist/shared/ 2>/dev/null || true",
    "build:telegram-bot": "tsc && cp -r dist/src/telegram-bot/* dist/telegram-bot/ 2>/dev/null || true",
    "build:services": "tsc && cp -r dist/src/services/* dist/services/ 2>/dev/null || true",
    "build:web": "cd src/web && astro build",
    "test": "vitest --run",
    "test:ci": "vitest --run --reporter=verbose --coverage",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --run src/**/tests/unit/**/*.test.ts",
    "test:integration": "vitest --run src/**/tests/integration/**/*.test.ts",
    "test:e2e": "vitest --run src/**/tests/e2e/**/*.test.ts",
    "test:telegram": "vitest --run src/telegram-bot/tests/**/*.test.ts",
    "test:web": "vitest --run src/web/tests/**/*.test.ts",
    "test:shared": "vitest --run src/shared/tests/**/*.test.ts",
    "test:services": "vitest --run src/services/tests/**/*.test.ts",
    "test:db": "vitest --run src/db/tests/**/*.test.ts",
    "test:runner": "tsx scripts/test-runner.ts",
    "test:all": "tsx scripts/test-runner.ts all",
    "test:report": "tsx scripts/test-runner.ts coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/*/dist",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=src/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/node": "^9.2.2",
    "@cloudflare/containers": "^0.0.17",
    "@cloudflare/workers-types": "^4.20250702.0",
    "@tailwindcss/vite": "^4.1.11",
    "alchemy": "^0.43.0",
    "astro": "^5.10.2",
    "dotenv": "^17.0.0",
    "grammy": "^1.36.3",
    "hono": "^4.8.3",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.8.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/vite-plugin": "^1.8.0",
    "@cloudflare/vitest-pool-workers": "^0.8.48",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "better-sqlite3": "^12.1.1",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.2",
    "jsdom": "^26.1.0",
    "miniflare": "^4.20250617.4",
    "oxlint": "^1.5.0",
    "tsx": "^4.20.3",
    "typescript": "5.8.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.22.0"
  },
  "cloudflare": {
    "label": "Containers Starter",
    "products": [
      "Workers",
      "Durable Objects",
      "Containers"
    ],
    "categories": [],
    "docs_url": "https://developers.cloudflare.com/containers/",
    "preview_image_url": "https://imagedelivery.net/_yJ02hpOMj_EnGvsU2aygw/5aba1fb7-b937-46fd-fa67-138221082200/public",
    "icon_urls": [
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"
    ]
  }
}
