{
  "name": "celebrum-ai",
  "description": "Celebrum AI Trading Platform - Complete Application",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "tsx scripts/deploy-alchemy.ts production",
    "deploy:alchemy": "tsx scripts/deploy-alchemy.ts production",
    "deploy:alchemy:staging": "tsx scripts/deploy-alchemy.ts staging",
    "deploy:alchemy:dev": "tsx scripts/deploy-alchemy.ts development",
    "deploy:alchemy:dry-run": "tsx scripts/deploy-alchemy.ts production --dry-run",
    "deploy:fallback": "./scripts/deploy/deploy-with-fallback.sh",
    "deploy:wrangler": "./scripts/deploy/deploy-wrangler-only.sh",
    "dev": "miniflare --modules --watch --debug --host 127.0.0.1 --port 8787 --kv CELEBRUM_KV --kv PROD_BOT_MARKET_CACHE --kv PROD_BOT_SESSION_STORE --d1 DB --do CELEBRUM_STORAGE=CelebrumAIStorage src/index.ts",
    "dev:worker": "miniflare --modules --watch --debug --host 127.0.0.1 --port 8787 --kv CELEBRUM_KV --kv PROD_BOT_MARKET_CACHE --kv PROD_BOT_SESSION_STORE --d1 DB --do CELEBRUM_STORAGE=CelebrumAIStorage src/index.ts",
    "dev:web": "astro dev --root src/web",
    "dev:telegram-bot": "miniflare --modules --watch --debug --host 127.0.0.1 --port 8787 --kv CELEBRUM_KV --kv PROD_BOT_MARKET_CACHE --kv PROD_BOT_SESSION_STORE --d1 DB --do CELEBRUM_STORAGE=CelebrumAIStorage src/index.ts",
    "start": "miniflare --modules --watch --debug --host 127.0.0.1 --port 8787 --kv CELEBRUM_KV --kv PROD_BOT_MARKET_CACHE --kv PROD_BOT_SESSION_STORE --d1 DB --do CELEBRUM_STORAGE=CelebrumAIStorage src/index.ts",
    "format": "echo 'Using oxlint for formatting'",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "build": "pnpm run build:web && pnpm exec tsc",
    "test:alchemy": "tsx scripts/test-alchemy-integration.ts",
    "build:db": "pnpm exec tsc && cp -r dist/src/db/* dist/db/ 2>/dev/null || true",
    "build:shared": "pnpm exec tsc && cp -r dist/src/shared/* dist/shared/ 2>/dev/null || true",
    "build:telegram-bot": "pnpm exec tsc && cp -r dist/src/telegram-bot/* dist/telegram-bot/ 2>/dev/null || true",
    "build:services": "pnpm exec tsc && cp -r dist/src/services/* dist/services/ 2>/dev/null || true",
    "build:web": "cd src/web && astro build",
    "test": "pnpm run build:test && vitest",
    "test:ci": "vitest --run --reporter=verbose",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest --run \"src/*/tests/unit/*.test.ts\" \"src/**/tests/unit/**/*.test.ts\" \"src/tests/unit.test.ts\"",
    "test:integration": "vitest --config ./vitest.db.config.ts",
    "test:e2e": "vitest --run \"src/*/tests/e2e/*.test.ts\" \"src/**/tests/e2e/**/*.test.ts\"",
    "test:telegram": "vitest --run src/telegram-bot/tests/**/*.test.ts",
    "test:web": "vitest --run src/web/tests/**/*.test.ts",
    "test:shared": "vitest --run src/shared/tests/**/*.test.ts",
    "test:services": "vitest --run src/services/tests/**/*.test.ts",
    "test:db": "vitest --config ./vitest.db.config.ts",
    "test:runner": "tsx scripts/test-runner.ts",
    "test:all": "tsx scripts/test-runner.ts all",
    "test:report": "tsx scripts/test-runner.ts coverage",
    "typecheck": "pnpm exec tsc --noEmit",
    "clean": "rm -rf dist src/*/dist",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=src/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "build:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@astrojs/node": "^9.3.0",
    "@cloudflare/containers": "^0.0.17",
    "@cloudflare/workers-types": "^4.20250709.0",
    "@tailwindcss/vite": "^4.1.11",
    "alchemy": "^0.43.5",
    "astro": "^5.11.0",
    "ccxt": "^4.4.92",
    "dotenv": "^17.1.0",
    "grammy": "^1.37.0",
    "hono": "^4.8.4",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.6.0",
    "@cloudflare/unenv-preset": "^2.3.3",
    "@cloudflare/vite-plugin": "^1.9.1",
    "@cloudflare/vitest-pool-workers": "^0.8.50",
    "@faker-js/faker": "^9.9.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.0.4",
    "@vitest/coverage-istanbul": "3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "better-sqlite3": "^12.2.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.2",
    "fast-glob": "^3.3.3",
    "jsdom": "^26.1.0",
    "miniflare": "^4.20250705.0",
    "oxlint": "^1.6.0",
    "playwright": "^1.54.1",
    "tsx": "^4.20.3",
    "typescript": "5.8.3",
    "unenv": "^1.10.0",
    "vite": "^7.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.24.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0"
    },
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "cloudflare": {
    "label": "Containers Starter",
    "products": [
      "Workers",
      "Durable Objects",
      "Containers"
    ],
    "categories": [],
    "docs_url": "https://developers.cloudflare.com/containers/",
    "preview_image_url": "https://imagedelivery.net/_yJ02hpOMj_EnGvsU2aygw/5aba1fb7-b937-46fd-fa67-138221082200/public",
    "icon_urls": [
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"
    ]
  }
}
