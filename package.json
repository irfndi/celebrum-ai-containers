{
  "name": "celebrum-ai",
  "description": "Celebrum AI Trading Platform - Complete Application",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:worker": "wrangler dev",
    "dev:web": "astro dev --root src/web",
    "dev:telegram-bot": "wrangler dev --compatibility-date=2024-01-01 --local",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "format": "echo 'Using oxlint for formatting'",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "build": "tsc --build",
    "build:db": "tsc --build src/db/tsconfig.json",
    "build:shared": "tsc --build src/shared/tsconfig.build.json",
    "build:telegram-bot": "tsc --build src/telegram-bot/tsconfig.json",
    "build:services": "tsc --project src/services/tsconfig.json",
    "build:web": "astro check --root src/web && astro build --root src/web",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/*/dist",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=src/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts"
   },
  "dependencies": {
    "@cloudflare/containers": "^0.0.13",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/node": "^9.2.2",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.10.0",
    "drizzle-orm": "^0.44.2",
    "grammy": "^1.36.3",
    "hono": "^4.8.3",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.8.1",
    "vite": "^6.3.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "24.0.3",
    "drizzle-kit": "^0.31.2",
    "oxlint": "^1.3.0",
    "tsup": "^8.5.0",
    "typescript": "5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.20.5"
  },
  "cloudflare": {
    "label": "Containers Starter",
    "products": [
      "Workers",
      "Durable Objects",
      "Containers"
    ],
    "categories": [],
    "docs_url": "https://developers.cloudflare.com/containers/",
    "preview_image_url": "https://imagedelivery.net/_yJ02hpOMj_EnGvsU2aygw/5aba1fb7-b937-46fd-fa67-138221082200/public",
    "icon_urls": [
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"
    ]
  }
}
