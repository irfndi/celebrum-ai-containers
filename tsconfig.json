{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "react",
    "resolveJsonModule": true,
    "allowJs": true,
    "esModuleInterop": true,
    "downlevelIteration": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": true,
    "composite": false,
    "outDir": "dist",
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@celebrum-ai/shared": [
        "./src/shared/src/index.ts"
      ],
      "@celebrum-ai/shared/*": [
        "./src/shared/src/*"
      ],
      "@celebrum-ai/db": [
        "./src/db/src/index.ts"
      ],
      "@celebrum-ai/db/*": [
        "./src/db/src/*"
      ],
      "@celebrum-ai/db/utils": [
        "./src/db/src/utils"
      ],
      "@celebrum-ai/db/utils/*": [
        "./src/db/src/utils/*"
      ],
      "@celebrum-ai/db/schema": [
        "./src/db/src/schema"
      ],
      "@celebrum-ai/db/schema/*": [
        "./src/db/src/schema/*"
      ],
      "@celebrum-ai/telegram-bot": [
        "./src/telegram-bot/src/index.ts"
      ],
      "@celebrum-ai/telegram-bot/*": [
        "./src/telegram-bot/src/*"
      ],
      "@celebrum-ai/services": [
        "./src/services/src/index.ts"
      ],
      "@celebrum-ai/services/*": [
        "./src/services/src/*"
      ],
      "@/tests/*": [
        "./src/tests/*"
      ],
      "@celebrum-ai/shared/tests/*": [
        "./src/shared/tests/*"
      ],
      "@celebrum-ai/utils/*": [
        "./src/shared/src/utils/*"
      ],
      "@celebrum-ai/errors": [
        "./src/shared/src/errors/index.ts"
      ],
      "@celebrum-ai/validation": [
        "./src/shared/src/validation/index.ts"
      ],
      "@celebrum-ai/constants": [
        "./src/shared/src/constants/index.ts"
      ],
      "@celebrum-ai/test-utils": [
        "./src/shared/tests/utils/test-helpers.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-test",
    "src/web/**/*",
    "src/web/dist/**/*"
  ],
  "ts-node": {
    "transpileOnly": true
  }
}