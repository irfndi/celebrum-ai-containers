{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celebrum-ai-containers",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALCHEMY_MANAGED": "true",
    "CONTAINER_VERSION": "1.0.0",
    "DEPLOYMENT_STRATEGY": "alchemy"
  },
  "containers": [
    {
      "class_name": "CelebrumContainer",
      "image": "./Dockerfile",
      "max_instances": 10,
      "name": "celebrum-ai-container",
      "environment": {
        "MESSAGE": "Hello from Alchemy-managed Celebrum AI!",
        "NODE_ENV": "production",
        "ALCHEMY_MANAGED": "true"
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "CelebrumContainer",
        "name": "CELEBRUM_CONTAINER"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["MyContainer"],
      "tag": "v1"
    },
    {
      "renamed_classes": [
        {
          "from": "MyContainer",
          "to": "CelebrumContainer"
        }
      ],
      "tag": "v2"
    }
  ]
}
