{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celebrum-ai-containers",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "pnpm run build:packages",
    "watch_dir": "../packages/shared/src"
  },
  "vars": {
    "API_SERVICE_URL": "http://127.0.0.1:8787"
  },
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "Celebrum_Container",
      "image": "./Dockerfile",
      "max_instances": 10,
      "name": "celebrum-containers"
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": [
        "Celebrum_SQL"
      ],
      "tag": "v1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ArbEdgeKV",
      "id": "975cbb73bbc047d5980d4c22c58e1cc7",
      "preview_id": "9db67fd132d64e93bcdf3cebebd07bc6"
    },
    {
      "binding": "PROD_BOT_MARKET_CACHE",
      "id": "0b76a94e2ab34f7b94bfb9268d9c6b7f",
      "preview_id": "9db67fd132d64e93bcdf3cebebd07bc6"
    },
    {
      "binding": "PROD_BOT_SESSION_STORE",
      "id": "3c74b10792214176a876be682d147871",
      "preview_id": "9db67fd132d64e93bcdf3cebebd07bc6"
    }
  ],
  "d1_databases": [
    {
      "binding": "ArbEdgeD1",
      "database_name": "prod-celebrum-ai",
      "database_id": "879bf844-93b2-433d-9319-6e6065bbfdfd",
      "migrations_dir": "../db/sql/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ArbEdgeR2",
      "bucket_name": "prod-celebrum-ai"
    },
    {
      "binding": "ArbEdgeR2_Analytics",
      "bucket_name": "prod-celebrum-ai-analytics"
    }
  ]
}