{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celebrum-ai-containers",
  "main": "src/index.ts",
  "account_id": "4d12ccdb69bc57519b6aac269a04c9af",
  "compatibility_date": "2025-05-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALCHEMY_MANAGED": "true",
    "CONTAINER_VERSION": "1.0.0",
    "DEPLOYMENT_STRATEGY": "alchemy"
  },
  "containers": {
    "bindings": [
      {
        "name": "CELEBRUM_CONTAINER",
        "image": "celebrum-ai-container",
        "build": {
          "dockerfile": "Dockerfile",
          "context": "container_src"
        }
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CELEBRUM_STORAGE",
        "class_name": "CelebrumAIStorage",
        "script_name": "celebrum-ai-containers"
      },
      {
        "name": "CELEBRUM_CONTAINER",
        "class_name": "CelebrumContainer",
        "script_name": "celebrum-ai-containers"
      }
    ]
  },
  "migrations": [
     {
       "tag": "v1",
       "new_classes": ["CelebrumAIStorage"]
     },
     {
       "tag": "v2",
       "new_classes": ["CelebrumContainer"]
     },
     {
       "tag": "v3",
       "deleted_classes": ["CelebrumContainer"]
     }
   ]
}