{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celebrum-ai-containers",
  "main": "src/index.ts",
  "account_id": "4d12ccdb69bc57519b6aac269a04c9af",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat_v2"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALCHEMY_MANAGED": "true",
    "CONTAINER_VERSION": "1.0.0",
    "DEPLOYMENT_STRATEGY": "alchemy",
    "STAGE": "prod"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prod-celebrum-ai",
      "database_id": "879bf844-93b2-433d-9319-6e6065bbfdfd",
      "migrations_dir": "src/db/sql/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "CelebrumAIStorage",
        "name": "CELEBRUM_STORAGE"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "CelebrumAIStorage"
      ]
    }
  ]
}