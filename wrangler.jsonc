{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celebrum-ai-containers",
  "main": "src/index.ts",
  "account_id": "4d12ccdb69bc57519b6aac269a04c9af",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat_v2"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALCHEMY_MANAGED": "true",
    "CONTAINER_VERSION": "1.0.0",
    "DEPLOYMENT_STRATEGY": "alchemy",
    "STAGE": "prod"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "celebrum-db",
      "database_id": "37da863b-3fb1-491a-94ad-42839afcb981",
      "migrations_dir": "src/db/sql/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CELEBRUM_KV",
      "id": "075dc31a53344ebdab68461a95e9cfd4"
    },
    {
      "binding": "PROD_BOT_MARKET_CACHE",
      "id": "c5b936f1c0eb4f50ae9519f64bd3c5d9"
    },
    {
      "binding": "PROD_BOT_SESSION_STORE",
      "id": "d090d03b365b4619800d96ad1da5ac8c"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "CelebrumAIStorage",
        "name": "CELEBRUM_STORAGE"
      }
    ]
  }
}